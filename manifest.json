{
   "manifest_version": 3,
   "name": "Lyra - YouTube Music Mini Player",
   "version": "0.1.3",
   "description": "Floating Picture-in-Picture mini player for YouTube Music",
   "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
   },
   "action": {
      "default_popup": "popup.html",
      "default_title": "Lyra Mini Player",
      "default_icon": {
         "16": "icons/icon16.png",
         "32": "icons/icon32.png",
         "48": "icons/icon48.png",
         "128": "icons/icon128.png"
      }
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "permissions": [
      "activeTab",
      "tabs",
      "scripting",
      "storage",
      "declarativeNetRequest",
      "declarativeNetRequestWithHostAccess"
   ],
   "host_permissions": [
      "*://music.youtube.com/*"
   ],
   "declarative_net_request": {
      "rule_resources": [
         {
            "id": "ruleset_youtube_ads",
            "enabled": true,
            "path": "rules/youtube_ads.json"
         }
      ]
   },
   "content_scripts": [
      {
         "matches": [
            "*://music.youtube.com/*"
         ],
         "js": [
            "content.js"
         ]
      }
   ],
   "web_accessible_resources": [
      {
         "resources": [
            "miniplayer.css",
            "miniplayer.html"
         ],
         "matches": [
            "*://music.youtube.com/*"
         ]
      }
   ]
}