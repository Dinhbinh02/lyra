{
   "manifest_version": 3,
   "name": "__MSG_appName__",
   "default_locale": "en",
   "version": "0.1.6",
   "description": "__MSG_appDescription__",
   "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
   },
   "action": {
      "default_popup": "popup.html",
      "default_title": "Lyra Mini Player",
      "default_icon": {
         "16": "icons/icon16.png",
         "32": "icons/icon32.png",
         "48": "icons/icon48.png",
         "128": "icons/icon128.png"
      }
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "permissions": [
      "activeTab",
      "tabs",
      "scripting",
      "storage"
   ],
   "host_permissions": [
      "*://music.youtube.com/*"
   ],
   "content_scripts": [
      {
         "matches": [
            "*://music.youtube.com/*"
         ],
         "js": [
            "dist/content.js"
         ],
         "run_at": "document_start"
      }
   ],
   "web_accessible_resources": [
      {
         "resources": [
            "miniplayer.css",
            "miniplayer.html",
            "miniplayer.js",
            "icons/*"
         ],
         "matches": [
            "*://music.youtube.com/*"
         ]
      }
   ]
}